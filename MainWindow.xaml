<Window x:Class="NetSpeedWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSpeedWidget"
        Width="210"
        Height="28"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.ContextMenu>
        <ContextMenu>

            <MenuItem Header="Text Color">

                <MenuItem x:Name="WhiteMenu"
                          Header="White"
                          IsCheckable="True"
                          Click="White_Click"/>

                <MenuItem x:Name="GreenMenu"
                          Header="Green"
                          IsCheckable="True"
                          Click="Green_Click"/>

                <MenuItem x:Name="YellowMenu"
                          Header="Yellow"
                          IsCheckable="True"
                          Click="Yellow_Click"/>

                <MenuItem x:Name="CyanMenu"
                          Header="Cyan"
                          IsCheckable="True"
                          Click="Cyan_Click"/>

                <MenuItem x:Name="RedMenu"
                          Header="Red"
                          IsCheckable="True"
                          Click="Red_Click"/>

            </MenuItem>

            <Separator/>

            <MenuItem x:Name="LockPositionMenu"
                      Header="Lock Position"
                      IsCheckable="True"
                      Click="LockPosition_Click"/>

            <MenuItem x:Name="StartupMenu"
                      Header="Start with Windows"
                      IsCheckable="True"
                      Click="Startup_Click"/>

            <MenuItem Header="Font Size" Click="FontSize_Click"/>

            <Separator/>

            <MenuItem Header="Exit"
                      Click="Exit_Click"/>

        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="#01000000"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            MouseRightButtonUp="Border_MouseRightButtonUp">

        <Grid Margin="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DownloadText"
                       Grid.Column="0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="↓ 0 KB/s"/>

            <TextBlock Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="│"/>

            <TextBlock x:Name="UploadText"
                       Grid.Column="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="↑ 0 KB/s"/>

        </Grid>

    </Border>

</Window>